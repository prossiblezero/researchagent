# Copy to .env and fill in real credentials. Never commit .env.
PROVIDER=deepseek
BASE_URL=https://api.deepseek.com/v1
API_KEY=your-deepseek-api-key
MODEL=deepseek-chat
# Optional second provider. Keep the existing DeepSeek configuration above.
SUDOCODE_BASE_URL=https://api.sudocode.chat/v1
SUDOCODE_API_KEY=
# Use the exact model IDs enabled by your Sudocode account; aliases can be changed here.
SUDOCODE_LUNA_MODEL=gpt-5.6-luna
SUDOCODE_TERRA_MODEL=gpt-5.6-terra
SUDOCODE_SOL_MODEL=gpt-5.6-sol
# Maximum wait per model request, in seconds (reasoning can exceed 45 seconds).
SUDOCODE_TIMEOUT_SECONDS=180
TAVILY_API_KEY=your-tavily-api-key
# TAVILY_URL=https://api.tavily.com/search
# DB_PATH=data/evidence_agent.db
# PORT=8000
# HOST=127.0.0.1
# OFFLINE_MODE=1  # explicit fixed-data demo; omit for real model/search

# Optional local decision router. Default preserves the original LLM route.
ROUTER_MODE=llm
# cascade uses dev-calibrated confidence gates; decision is evaluation-only.
# DECISION_ROUTER_MODEL=data/models/Qwen3-0.6B
# DECISION_ROUTER_ADAPTER=data/models/decision-router/<selected-adapter>
# DECISION_ROUTER_DEVICE=auto
# 4B 免训练对照可用 config/decision_router_c1_4b.json；是否使用级联须看开发集选择记录。
# DECISION_ROUTER_CONFIG=config/decision_router.json
